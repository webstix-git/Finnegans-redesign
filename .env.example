# Public site URL for SEO metadata (used in production on Vercel)
NEXT_PUBLIC_SITE_URL=https://www.finneganswakesgf.com

# ── Vercel Blob (menu + promotions content) ──────────────────────────
# Required to save editor changes on Vercel (Preview + Production).
# Enable for BOTH Preview and Production in Vercel env var settings.
BLOB_READ_WRITE_TOKEN=

# Set automatically when a Blob store is linked to the Vercel project.
# On Vercel, OIDC auth is resolved at runtime — you do not need VERCEL_OIDC_TOKEN.
# BLOB_STORE_ID=

# Verifies Blob upload-completed webhooks (set in Vercel — do not commit the value)
BLOB_WEBHOOK_PUBLIC_KEY=

# Menu blob visibility: private (default) or public
# BLOB_MENU_ACCESS=private

# ── Google Analytics 4 + Search Console ──────────────────────────────
# GA4 measurement ID. Tracking loads only when set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-9RLEC01TZY
# Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=_UdTA0ZI9etvvBpEogTZ2yHN8ss_J5SwXIFbM1Tn3WI

# ── Cloudflare Turnstile (contact form spam protection) ──────────────
# Site key is public (rendered in the browser widget); secret key is server-only.
# When unset, the contact form works without a Turnstile challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Menu editor login (set in Vercel — do not commit real values)
# Use the exact value only in Vercel env vars, without extra quotes.
MENU_EDITOR_EMAIL=webadmin
MENU_EDITOR_PASSWORD=webadmin
MENU_EDITOR_SECRET=finnegans-menu-editor
